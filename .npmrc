# Supply-chain safety: refuse to install a version published less than 7 days ago, so a
# compromised release has a window to be caught and yanked before it reaches a build.
minimum-release-age=10080

# The build runs on the Traefik dev box from a git checkout, and pnpm resolves the
# lockfile's `resolved` hosts verbatim. Pin the public registry so a machine with an
# internal Artifactory mirror in its user config doesn't produce an unreproducible install.
# NOTE: npm/pnpm do not walk up for registry config — web/ needs its own copy of this file.
registry=https://registry.npmjs.org/
