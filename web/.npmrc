# A deliberate duplicate of the root .npmrc. npm and pnpm do NOT walk up the tree for
# registry config, and web/ is its own install root (own lockfile, own node_modules, built
# by its own Dockerfile). Without this file, a machine with an internal Artifactory mirror in
# its user config produces a lockfile pinning hosts the dev box cannot reach.
minimum-release-age=10080
registry=https://registry.npmjs.org/
